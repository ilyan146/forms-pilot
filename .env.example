# Azure OpenAI resource with a vision-capable chat deployment (for example gpt-4.1 or gpt-4o).
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Local development: serves /sample-form, and lets the extension call the API without a token
# while API_TOKENS is empty. Never set this on a deployed server.
DEV_MODE=true

# One name:token pair per person, comma-separated. Generate a token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKENS=
# Requests to /api/extract per person per minute.
RATE_LIMIT_PER_MINUTE=10
